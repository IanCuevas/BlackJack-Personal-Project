<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; opacity: 1; align-items: stretch;">
        <ui:Label text="Label" name="Dealer-Card-One" style="height: 200px; width: 500px; flex-direction: column; justify-content: flex-start; align-self: flex-start; align-content: flex-start; align-items: flex-start; top: 4%; font-size: 50px; -unity-text-align: middle-center; -unity-font-style: bold; flex-wrap: nowrap; left: auto; right: -20%;"/>
        <ui:Label text="Label" name="Dealer-Card-Two" style="height: 200px; width: 500px; flex-direction: column; justify-content: flex-start; align-self: center; align-content: flex-start; align-items: stretch; top: -15%; font-size: 50px; -unity-text-align: middle-center; -unity-font-style: bold; flex-wrap: nowrap; right: -15%;"/>
        <ui:Label text="Label" name="Player-Card-One" style="height: 200px; width: 500px; flex-direction: column; justify-content: flex-start; align-self: center; align-content: flex-start; align-items: stretch; top: 15%; font-size: 50px; -unity-text-align: middle-center; -unity-font-style: bold; right: 17%;"/>
        <ui:Label text="Label" name="Player-Card-Two" style="height: 200px; width: 500px; flex-direction: column; justify-content: flex-start; align-self: center; align-content: flex-start; align-items: stretch; top: -4%; font-size: 50px; -unity-text-align: middle-center; -unity-font-style: bold; right: -15%;"/>
        <ui:Button text="Randomizer" name="Randomizer" style="align-self: center; top: 0%; width: 350px; height: 200px; font-size: 50px; -unity-font-style: bold;"/>
    </ui:VisualElement>
</ui:UXML>
